# Copy to server/.env (or let `pnpm db:setup` create it for you).
# server/.env is git-ignored. NEVER commit it or paste its values anywhere.

NODE_ENV=development
PORT=3001
# Set to the number of reverse proxies in front of the API (0 = none).
TRUST_PROXY=0

# Origins allowed to call the API from a browser (comma separated, exact match).
CORS_ORIGINS=http://localhost:8443,http://localhost:8444

# Public address of the site, for link previews (og:url, og:image). Defaults to
# the first CORS origin in production and to the request's own host otherwise.
# SITE_URL=https://diciobase.example

# --- MySQL -----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=diciobase
# Runtime account: can only read dictionary tables, use my_* row-scoped views
# and call auth_* procedures. It has NO access to the users/sessions tables.
DB_APP_USER=diciobase_app
DB_APP_PASSWORD=
# Owner account: migrations and dataset imports only. Not used by the API.
DB_MIGRATOR_USER=diciobase_migrator
DB_MIGRATOR_PASSWORD=
# Set to true when MySQL is not on the same machine (TLS required).
DB_SSL=false

# --- Secrets (64 hex chars each; `pnpm db:setup` generates them) -----------
# Signs the per-request row-level-security context checked inside MySQL.
RLS_SECRET=
# Mixed into every password before argon2id hashing.
PASSWORD_PEPPER=

# --- Sessions --------------------------------------------------------------
SESSION_COOKIE_NAME=sid
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7
