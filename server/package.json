{
  "name": "diciobase-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_ENV=test LOG_LEVEL=silent tsx --test --test-concurrency=1 test/*.test.ts",
    "datasets:fetch": "tsx scripts/fetch-datasets.ts",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:import": "tsx scripts/import-datasets.ts",
    "export:static": "tsx scripts/export-static.ts",
    "db:local": "tsx scripts/local-mysql.ts start",
    "db:local:stop": "tsx scripts/local-mysql.ts stop",
    "db:setup:local": "tsx scripts/local-mysql.ts setup"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "satori": "^0.63.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
